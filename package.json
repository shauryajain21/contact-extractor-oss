{
  "name": "worklog",
  "version": "0.1.0",
  "description": "Local-first daily worklog: reads your chats, commits, mail and Slack, extracts who you worked with and what moved, and writes it into your Obsidian vault.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "worklog": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "verify": "npm run typecheck && npm test"
  },
  "dependencies": {
    "imapflow": "^2.0.6",
    "mailparser": "^3.9.28"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
